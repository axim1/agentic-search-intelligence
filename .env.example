APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/search_intelligence.db
LOG_LEVEL=INFO

# mock requires no credentials; live never falls back to fixtures.
DATAFORSEO_MODE=mock
MOCK_SCENARIO=happy_path
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_CHATGPT_MODEL=gpt-4.1-mini

# mock uses a deterministic tool-calling planner and deterministic synthesis.
LLM_MODE=mock
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

DEFAULT_LOCATION_CODE=2840
DEFAULT_LANGUAGE_CODE=en
DEFAULT_COUNTRY_ISO_CODE=US
DEFAULT_MAX_QUERIES=2
MAX_RETRIEVAL_CALLS=6
DATAFORSEO_MAX_CONCURRENCY=2
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_WRITE_TIMEOUT_SECONDS=5
HTTP_POOL_TIMEOUT_SECONDS=3
MAX_API_ATTEMPTS=3
BACKOFF_BASE_SECONDS=0.5
BACKOFF_CAP_SECONDS=8
RUN_TIMEOUT_SECONDS=60

